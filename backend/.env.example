# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (Supabase Postgres) - use the "Transaction" pooler URL for DATABASE_URL (pgbouncer, port 6543)
# and the direct connection URL for DIRECT_URL (port 5432) so Prisma migrations work correctly.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.zqnlpbsqcdzxbwvwuueq.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.zqnlpbsqcdzxbwvwuueq.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://zqnlpbsqcdzxbwvwuueq.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="question-images"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
